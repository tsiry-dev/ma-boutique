{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Se connecter | M Boutique{% endblock %}

{% block body %}

    <div class="grid min-h-screen lg:grid-cols-2">
        <div class="relative hidden overflow-hidden lg:block">

            <img
                src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=85"
                alt="Boutique de mode M Boutique"
                class="absolute inset-0 h-full w-full object-cover"
            >
            <div class="absolute inset-0 bg-black/40"></div>
            <div class="relative flex h-full flex-col justify-between p-10">
                <a
                    href="{{ path('home') }}"
                    class="flex items-center gap-2 text-white"
                >
                    <span class="flex size-10 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
                        {{ ux_icon('bi:bag', {
                        class: 'size-5'
                    }) }}
                    </span>

                    <span class="text-xl font-bold">
                        M Boutique
                    </span>
                </a>
                <div class="max-w-md text-white">
                    <span class="mb-4 inline-flex rounded-full bg-white/10 px-3 py-1 text-xs font-medium backdrop-blur-sm">
                        Mode & Style
                    </span>
                    <h2 class="text-4xl font-bold leading-tight">
                        Votre style,
                        <span class="text-orange-300">
                            votre identité.
                        </span>
                    </h2>
                    <p class="mt-4 text-sm leading-6 text-white/80">
                        Retrouvez vos articles préférés et découvrez
                        les dernières tendances sélectionnées par
                        M Boutique.
                    </p>
                </div>
            </div>
        </div>

        <div class="flex min-h-screen items-center justify-center px-5 py-8 sm:px-8">
            <div class="w-full max-w-md">
                <div class="mb-6">
                    <a
                        href="{{ path('home') }}"
                        class="mb-5 inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-primary-dark dark:text-gray-400"
                    >
                        {{ ux_icon('bi:arrow-left', {
                        class: 'size-4'
                    }) }}
                        <span>Accueil</span>
                    </a>
                    <h1 class="text-2xl font-bold tracking-tight text-secondary-dark dark:text-white">
                        Bon retour !
                    </h1>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                        Connectez-vous à votre compte M Boutique.
                    </p>
                </div>
                {% if error %}
                    <div
                        class="mb-5 flex items-start gap-3 rounded-lg border border-danger-dark/20 bg-danger-light px-3 py-2.5 text-sm text-danger-dark"
                        role="alert"
                    >
                        {{ ux_icon('bi:exclamation-circle', {
                        class: 'mt-0.5 size-4 shrink-0'
                    }) }}
                        <span>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </span>
                    </div>
                {% endif %}

                {% if app.user %}

                    <div
                        class="mb-5 rounded-lg border border-primary-dark/20 bg-primary-light px-4 py-3 text-sm text-primary-dark"
                    >

                        <div class="flex items-start gap-3">

                            {{ ux_icon('bi:person-check', {
                            class: 'mt-0.5 size-4 shrink-0'
                        }) }}

                            <div>

                                <p class="font-medium">
                                    Vous êtes déjà connecté.
                                </p>

                                <p class="mt-1 text-xs">
                                    {{ app.user.userIdentifier }}
                                </p>

                                <a
                                    href="{{ logout_path() }}"
                                    class="mt-2 inline-block font-semibold underline"
                                >
                                    Se déconnecter
                                </a>

                            </div>

                        </div>

                    </div>

                {% endif %}


                {# ====================================================
               FORMULAIRE
               ==================================================== #}
                <form
                    method="post"
                    class="space-y-4"
                >

                    {# Email #}
                    <div class="space-y-1.5">

                        <label
                            for="username"
                            class="text-sm font-medium text-secondary-dark dark:text-gray-200"
                        >
                            Adresse e-mail
                        </label>

                        <div class="relative">

                            {{ ux_icon('bi:envelope', {
                            class: 'pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-gray-400'
                        }) }}

                            <input
                                type="email"
                                value="{{ last_username }}"
                                name="_username"
                                id="username"
                                class="w-full rounded-lg border border-gray-300 bg-white py-2.5 pl-10 pr-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-primary-dark focus:ring-2 focus:ring-primary-dark/20 dark:border-gray-700 dark:bg-secondary-dark dark:text-white dark:placeholder:text-gray-500"
                                placeholder="exemple@email.com"
                                autocomplete="email"
                                required
                                autofocus
                            >

                        </div>

                    </div>


                    {# Mot de passe #}
                    <div class="space-y-1.5">

                        <div class="flex items-center justify-between">

                            <label
                                for="password"
                                class="text-sm font-medium text-secondary-dark dark:text-gray-200"
                            >
                                Mot de passe
                            </label>

                            <a
                                href="#"
                                class="text-xs font-semibold text-primary-dark transition hover:text-orange-700"
                            >
                                Mot de passe oublié ?
                            </a>

                        </div>

                        <div class="relative">

                            {{ ux_icon('bi:lock', {
                            class: 'pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-gray-400'
                        }) }}

                            <input
                                type="password"
                                name="_password"
                                id="password"
                                class="w-full rounded-lg border border-gray-300 bg-white py-2.5 pl-10 pr-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-primary-dark focus:ring-2 focus:ring-primary-dark/20 dark:border-gray-700 dark:bg-secondary-dark dark:text-white dark:placeholder:text-gray-500"
                                placeholder="Votre mot de passe"
                                autocomplete="current-password"
                                required
                            >

                        </div>

                    </div>


                    {# Remember me #}
                    <div class="flex items-center">

                        <input
                            type="checkbox"
                            name="_remember_me"
                            id="_remember_me"
                            class="size-4 rounded border-gray-300 text-primary-dark focus:ring-primary-dark"
                        >

                        <label
                            for="_remember_me"
                            class="ml-2 text-xs text-gray-500 dark:text-gray-400"
                        >
                            Se souvenir de moi
                        </label>

                    </div>


                    {# CSRF #}
                    <input
                        type="hidden"
                        name="_csrf_token"
                        data-controller="csrf-protection"
                        value="{{ csrf_token('authenticate') }}"
                    >


                    {# Bouton connexion #}
                    <button
                        type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary-dark px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-primary-dark focus:ring-offset-2 dark:focus:ring-offset-secondary-dark"
                    >

                        {{ ux_icon('bi:box-arrow-in-right', {
                        class: 'size-4'
                    }) }}

                        <span>
                            Se connecter
                        </span>

                    </button>

                </form>


                {# ====================================================
               INSCRIPTION
               ==================================================== #}
                <div class="mt-5 text-center">

                    <p class="text-sm text-gray-500 dark:text-gray-400">

                        Vous n'avez pas encore de compte ?

                        <a
                            href="{{ path('app_register') }}"
                            class="font-semibold text-primary-dark transition hover:text-orange-700"
                        >
                            Créer un compte
                        </a>

                    </p>

                </div>


                {# ====================================================
               SÉCURITÉ
               ==================================================== #}
                <p class="mt-5 text-center text-xs text-gray-400">

                    {{ ux_icon('bi:shield-check', {
                    class: 'mr-1 inline-block size-3.5 align-text-bottom'
                }) }}

                    Vos informations sont protégées en toute sécurité.

                </p>

            </div>

        </div>

    </div>

{% endblock %}
