{% extends 'base.html.twig' %}

{% block title %}
    Addresses | M boutique
{% endblock %}

{% block body %}

     <twig:Account:AccountLayout>
        <div id="adresses" class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm sm:p-10 dark:border-gray-800 dark:bg-ghost-dark">

            <div class="mb-8 flex items-center justify-between">
                <h2 class="text-2xl font-black sm:text-3xl">
                    Mes adresses
                </h2>

                <twig:UI:Button variant="secondary" tag="a" href="#">
                    Ajouter une adresse
                    <twig:ux:icon name="bi:plus-lg" class="size-4"/>
                </twig:UI:Button>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">

                <div class="relative rounded-2xl border border-gray-200 p-6 dark:border-gray-800">

                    <span class="absolute top-6 right-6 rounded-full bg-primary-light px-2.5 py-1 text-[11px] font-semibold text-primary-dark dark:bg-primary-dark/10">
                        Par défaut
                    </span>

                    <div class="flex size-10 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
                        <twig:ux:icon name="bi:geo-alt-fill" class="size-5"/>
                    </div>

                    <p class="mt-4 pr-20 font-bold">Domicile</p>
                    <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
                        Lot II M 45 Ankorondrano<br>
                        101 Antananarivo<br>
                        Madagascar
                    </p>

                    <div class="mt-4 flex gap-4 text-sm">
                        <a href="#" class="font-semibold text-primary-dark hover:underline">Modifier</a>
                        <a href="#" class="font-semibold text-danger-dark hover:underline">Supprimer</a>
                    </div>

                </div>

                <div class="relative rounded-2xl border border-gray-200 p-6 dark:border-gray-800">

                    <div class="flex size-10 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
                        <twig:ux:icon name="bi:geo-alt-fill" class="size-5"/>
                    </div>

                    <p class="mt-4 font-bold">Bureau</p>
                    <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
                        Immeuble Fitaratra, Ankorondrano<br>
                        101 Antananarivo<br>
                        Madagascar
                    </p>

                    <div class="mt-4 flex gap-4 text-sm">
                        <a href="#" class="font-semibold text-primary-dark hover:underline">Modifier</a>
                        <a href="#" class="font-semibold text-danger-dark hover:underline">Supprimer</a>
                    </div>

                </div>

            </div>
        </div>
     </twig:Account:AccountLayout>

{% endblock %}
