{% extends 'base.html.twig' %}

{% block title %}
    Commande | M boutique
{% endblock %}

{% block body %}
    <twig:Account:AccountLayout>
        <div id="commandes" class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm sm:p-10 dark:border-gray-800 dark:bg-ghost-dark">

            <div class="mb-8 flex items-center justify-between">
                <h2 class="text-2xl font-black sm:text-3xl">
                    Mes commandes récentes
                </h2>

                <twig:UI:Button variant="ghost" tag="a" href="#">
                    Voir tout
                    <twig:ux:icon name="bi:arrow-right" class="size-4"/>
                </twig:UI:Button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-gray-200 text-gray-500 dark:border-gray-800 dark:text-gray-400">
                            <th class="pb-3 font-semibold">Commande</th>
                            <th class="pb-3 font-semibold">Date</th>
                            <th class="pb-3 font-semibold">Statut</th>
                            <th class="pb-3 font-semibold">Total</th>
                            <th class="pb-3 font-semibold text-right">Détail</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800/60">
                            <td class="py-4 font-semibold">#CMD-1042</td>
                            <td class="py-4 text-gray-500 dark:text-gray-400">12/08/2026</td>
                            <td class="py-4">
                                <span class="rounded-full bg-success-light px-2.5 py-1 text-xs font-semibold text-success-dark dark:bg-success-dark/10">Livrée</span>
                            </td>
                            <td class="py-4 font-semibold">89 900 Ar</td>
                            <td class="py-4 text-right">
                                <a href="#" class="font-semibold text-primary-dark hover:underline">Voir</a>
                            </td>
                        </tr>
                        <tr class="border-b border-gray-100 last:border-0 dark:border-gray-800/60">
                            <td class="py-4 font-semibold">#CMD-1039</td>
                            <td class="py-4 text-gray-500 dark:text-gray-400">02/08/2026</td>
                            <td class="py-4">
                                <span class="rounded-full bg-primary-light px-2.5 py-1 text-xs font-semibold text-primary-dark dark:bg-primary-dark/10">En cours</span>
                            </td>
                            <td class="py-4 font-semibold">152 000 Ar</td>
                            <td class="py-4 text-right">
                                <a href="#" class="font-semibold text-primary-dark hover:underline">Voir</a>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-4 font-semibold">#CMD-1021</td>
                            <td class="py-4 text-gray-500 dark:text-gray-400">18/07/2026</td>
                            <td class="py-4">
                                <span class="rounded-full bg-danger-light px-2.5 py-1 text-xs font-semibold text-danger-dark dark:bg-danger-dark/10">Annulée</span>
                            </td>
                            <td class="py-4 font-semibold">45 000 Ar</td>
                            <td class="py-4 text-right">
                                <a href="#" class="font-semibold text-primary-dark hover:underline">Voir</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </twig:Account:AccountLayout>
{% endblock %}
