{% extends 'base.html.twig' %}

{% block title %}
	Contact | M boutique
{% endblock %}

{% block body %}

	<section class="relative overflow-hidden bg-secondary-dark text-white">

		<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(234,88,12,0.18),transparent_40%)]"></div>

		<div class="relative mx-auto max-w-7xl px-6 py-24 lg:py-28">

			<div class="max-w-3xl">

				<p class="mb-5 text-sm font-semibold uppercase tracking-[0.3em] text-primary-dark">
					Contact
				</p>

				<h1 class="text-5xl font-black leading-tight sm:text-6xl lg:text-7xl">
					Parlons de
					<span class="text-primary-dark">
						votre projet.
					</span>
				</h1>

				<p class="mt-7 max-w-2xl text-lg leading-8 text-white/70">
					Une question sur un produit, une commande ou simplement
					besoin d'informations ? Notre équipe est là pour vous aider.
				</p>

			</div>

		</div>
	</section>

	<section class="bg-gray-50 py-20 dark:bg-secondary-dark">

		<div class="mx-auto max-w-7xl px-6">

			<div
				class="grid gap-8 lg:grid-cols-3"
			>
				<div class="space-y-6">

					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-dark">
							Parlons ensemble
						</p>

						<h2 class="mt-3 text-3xl font-black">
							Nous contacter
						</h2>

						<p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
							Nous sommes disponibles pour répondre à vos
							questions et vous accompagner.
						</p>
					</div>

					<div class="flex gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-ghost-dark">

						<div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
							<twig:ux:icon name="bi:geo-alt" class="size-6"/>
						</div>

						<div>
							<h3 class="font-bold">
								Adresse
							</h3>

							<p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
								Antananarivo, Madagascar
							</p>
						</div>

					</div>

					<div class="flex gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-ghost-dark">

						<div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
							<twig:ux:icon name="bi:telephone" class="size-6"/>
						</div>

						<div>
							<h3 class="font-bold">
								Téléphone
							</h3>

							<a href="tel:+261000000000" class="mt-1 block text-sm text-gray-600 transition hover:text-primary-dark dark:text-gray-400">
								+261 00 000 00 000
							</a>
						</div>

					</div>

					<div class="flex gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-ghost-dark">

						<div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
							<twig:ux:icon name="bi:envelope" class="size-6"/>
						</div>

						<div>
							<h3 class="font-bold">
								Email
							</h3>

							<a href="mailto:contact@maboutique.com" class="mt-1 block text-sm text-gray-600 transition hover:text-primary-dark dark:text-gray-400">
								contact@maboutique.com
							</a>
						</div>

					</div>

					<div class="flex gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-ghost-dark">

						<div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
							<twig:ux:icon name="bi:clock" class="size-6"/>
						</div>

						<div>
							<h3 class="font-bold">
								Horaires
							</h3>

							<p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
								Lundi — Vendredi : 08:00 — 18:00
								<br>
								Samedi : 09:00 — 15:00
							</p>
						</div>

					</div>

				</div>

				<div class="lg:col-span-2">

					<div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm sm:p-10 dark:border-gray-800 dark:bg-ghost-dark">

						<div class="mb-8">

							<h2 class="text-2xl font-black sm:text-3xl">
								Envoyez-nous un message
							</h2>

							<p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">
								Remplissez le formulaire ci-dessous et nous
								vous répondrons dès que possible.
							</p>

						</div>


						<form
							action="#"
							method="post"
							class="space-y-6"
						>

							<div class="grid gap-6 sm:grid-cols-2">

								<div>
									<label for="name" class="mb-2 block text-sm font-semibold">
										Nom complet
									</label>

									<input id="name" name="name" type="text" placeholder="Votre nom" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-primary-dark focus:ring-2 focus:ring-primary-dark/20 dark:border-gray-700 dark:bg-secondary-dark dark:placeholder:text-gray-500">
								</div>


								<div>
									<label for="email" class="mb-2 block text-sm font-semibold">
										Adresse email
									</label>

									<input id="email" name="email" type="email" placeholder="vous@example.com" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-primary-dark focus:ring-2 focus:ring-primary-dark/20 dark:border-gray-700 dark:bg-secondary-dark dark:placeholder:text-gray-500">
								</div>

							</div>

							<div>

								<label for="subject" class="mb-2 block text-sm font-semibold">
									Sujet
								</label>

								<input id="subject" name="subject" type="text" placeholder="Comment pouvons-nous vous aider ?" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-primary-dark focus:ring-2 focus:ring-primary-dark/20 dark:border-gray-700 dark:bg-secondary-dark dark:placeholder:text-gray-500">

							</div>


							<div>

								<label for="message" class="mb-2 block text-sm font-semibold">
									Message
								</label>

								<textarea id="message" name="message" rows="7" placeholder="Écrivez votre message..." class="w-full resize-none rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-primary-dark focus:ring-2 focus:ring-primary-dark/20 dark:border-gray-700 dark:bg-secondary-dark dark:placeholder:text-gray-500"></textarea>

							</div>

							<div class="flex justify-end">

								<twig:UI:Button type="submit" variant="primary" size="lg">
									Envoyer le message

									<twig:ux:icon name="bi:send" class="size-4"/>
								</twig:UI:Button>

							</div>

						</form>

					</div>

				</div>

			</div>

		</div>

	</section>

	<section class="bg-white py-20 dark:bg-secondary-dark">

		<div class="mx-auto max-w-7xl px-6">

			<div
				class="grid overflow-hidden rounded-3xl border border-gray-200 bg-gray-100 dark:border-gray-800 dark:bg-ghost-dark lg:grid-cols-2"
			>
				<div class="flex flex-col justify-center p-8 sm:p-12">

					<p class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-dark">
						Retrouvez-nous
					</p>

					<h2 class="mt-4 text-4xl font-black">
						Notre boutique
					</h2>

					<p class="mt-5 leading-8 text-gray-600 dark:text-gray-400">
						Venez découvrir notre univers directement en boutique.
						Notre équipe sera heureuse de vous accueillir et de
						vous conseiller.
					</p>

					<div class="mt-8">

						<twig:UI:Button variant="secondary" tag="a" href="#">
							Voir l'emplacement

							<twig:ux:icon name="bi:arrow-up-right" class="size-4"/>
						</twig:UI:Button>

					</div>

				</div>
				
				<div
					data-controller="map"
					data-map-marker-icon-value="{{ ux_icon('bi:geo-alt-fill', {
						class: 'size-10 text-primary-dark'
					})|e('html_attr') }}"
					class="h-[400px] w-full z-10"
				></div>


			</div>

		</div>

	</section>

	<section class="bg-gray-50 py-20 dark:bg-ghost-dark">

		<div class="mx-auto max-w-4xl px-6 text-center">

			<twig:ux:icon name="bi:question-circle" class="mx-auto size-10 text-primary-dark"/>

			<h2 class="mt-5 text-3xl font-black sm:text-4xl">
				Une question avant de commander ?
			</h2>

			<p class="mx-auto mt-4 max-w-2xl leading-7 text-gray-600 dark:text-gray-400">
				Consultez notre FAQ ou contactez directement notre équipe.
				Nous serons heureux de vous aider.
			</p>

			<div class="mt-8 flex flex-wrap justify-center gap-4">

				<twig:UI:Button variant="primary" tag="a" href="#">
					Consulter la FAQ
					<twig:ux:icon name="bi:arrow-right" class="size-4"/>
				</twig:UI:Button>

				<twig:UI:Button variant="ghost" tag="a" href="#">
					Retour à l'accueil
				</twig:UI:Button>

			</div>

		</div>

	</section>

{% endblock %}
