{% set currentRoute = app.request.attributes.get('_route') %}
{% set isActive = currentRoute == route %}

<a
    {% if route %}
     href="{{ path(route) }}"
    {% endif %}
    
    {{ attributes.defaults({
        class: isActive
            ? 'flex gap-4 rounded-2xl border border-primary-dark bg-primary-light p-2 shadow-sm transition dark:border-primary-dark dark:bg-primary-dark/20'
            : 'flex gap-4 rounded-2xl border border-gray-200 bg-white p-2 shadow-sm transition hover:border-primary-dark/30 hover:bg-primary-light dark:border-gray-700 dark:bg-secondary-dark dark:hover:border-primary-dark/40 dark:hover:bg-primary-dark/10'
    }) }}
>
    {% if icon %}
        <div class="flex size-9 shrink-0 items-center justify-center rounded-xl {{ isActive ? 'bg-primary-dark text-white' : 'text-primary-dark border-1 border-primary-dark' }} ">
            <twig:ux:icon name="{{ icon }}" class="size-5"/>
        </div>
    {% endif %}
    

    <div>
        {% if title %}
            <h3 class="font-bold text-sm {{ isActive ? 'text-primary-dark' : 'text-secondary-dark dark:text-white' }}">
                {{ title }}
            </h3>
        {% endif %}
        

        {% if description %}
            <p class="mt-1 text-[.8rem] leading-6 {{ isActive ? 'text-primary-dark/80' : 'text-gray-500 dark:text-gray-400' }}">
                {{ description }}
            </p>
        {% endif %}
        
    </div>
</a>