<section class="mt-5 bg-gray-50 py-20 dark:bg-secondary-dark">
    <div class="mx-auto max-w-7xl px-6">
       {#--------Mobile menu--------#}
        <div class="mb-8 lg:hidden">
            <details class="group">
                <summary
                    class="flex cursor-pointer list-none items-center justify-between rounded-2xl border border-gray-200 bg-white p-4 shadow-sm transition hover:border-primary-dark/30 dark:border-gray-700 dark:bg-ghost-dark"
                >
                    <div class="flex items-center gap-3">
                        <div class="flex size-10 items-center justify-center rounded-xl bg-primary-dark text-white">
                            <twig:ux:icon name="bi:list" class="size-5"/>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-secondary-dark dark:text-white">
                                Espace client
                            </p>

                            <p class="text-xs text-gray-500 dark:text-gray-400">
                                Gérez votre compte
                            </p>
                        </div>

                    </div>
                    <twig:ux:icon
                        name="bi:chevron-down"
                        class="size-5 text-gray-500 transition-transform group-open:rotate-180 dark:text-gray-400"
                    />

                </summary>
                <div class="mt-3 space-y-2">
                    <twig:Account:AccountNavLink
                        route="app_account"
                        title="Mon profil"
                        description="Informations personnelles"
                        icon="bi:person"
                    />
                    <twig:Account:AccountNavLink
                        route="account.order"
                        title="Mes commandes"
                        description="5 commandes"
                        icon="bi:bag"
                    />
                    <twig:Account:AccountNavLink
                        route="account.address"
                        title="Mes adresses"
                        description="2 enregistrées"
                        icon="bi:geo-alt"
                    />
                    <twig:Account:AccountNavLink
                        route="account.security"
                        title="Sécurité"
                        description="Mot de passe & connexions"
                        icon="bi:shield-lock"
                    />
                    <twig:Account:AccountNavLink
                        route=""
                        title="Déconnexion"
                        description="Se déconnecter de votre compte"
                        icon="bi:box-arrow-right"
                    />
                </div>
            </details>
        </div>


       {#--------Desktop menu--------#}
        <div class="grid gap-8 lg:grid-cols-3">
            <aside class="hidden space-y-2 lg:block">

                <div class="mb-6">
                    <h3 class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-dark">
                        Espace client
                    </h3>
                    <p class="mt-4 leading-7 text-gray-600 dark:text-gray-400">
                        Accédez rapidement à vos informations et à vos
                        dernières activités.
                    </p>
                </div>
                <twig:Account:AccountNavLink
                    route="app_account"
                    title="Mon profil"
                    description="Informations personnelles"
                    icon="bi:person"
                />
                <twig:Account:AccountNavLink
                    route="account.order"
                    title="Mes commandes"
                    description="5 commandes"
                    icon="bi:bag"
                />
                <twig:Account:AccountNavLink
                    route="account.address"
                    title="Mes adresses"
                    description="2 enregistrées"
                    icon="bi:geo-alt"
                />
                <twig:Account:AccountNavLink
                    route="account.security"
                    title="Sécurité"
                    description="Mot de passe & connexions"
                    icon="bi:shield-lock"
                />
                <form
                    action="{{ path('app_logout') }}"
                    method="post"
                    class=""
                >
                    <button
                        type="submit"
                        class="flex group w-full gap-4 rounded-2xl border border-gray-200 bg-red-100 p-2 text-left shadow-sm transition hover:border-red-300 hover:bg-red-400 dark:border-gray-700 dark:bg-secondary-dark dark:hover:border-red-900 dark:hover:bg-red-950/20"
                    >
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-red-600 text-white">
                            <twig:ux:icon name="bi:box-arrow-right" class="size-5"/>
                        </div>

                        <div>
                            <h3 class="font-bold text-red-600 group-hover:text-white text-sm">
                                Déconnexion
                            </h3>

                            <p class="mt-1 text-[.7rem] group-hover:text-white leading-6 text-gray-500 dark:text-gray-400">
                                Se déconnecter de votre compte
                            </p>
                        </div>
                    </button>
                </form>
            </aside>

            {#-------- Contenu --------#}
            <div class="space-y-8 lg:col-span-2">
                {{ block("content") }}
            </div>
        </div>
    </div>
</section>


{#--------Support--------#}
<section class="mb-20 bg-gray-50 py-5 dark:bg-ghost-dark">
    <div class="mx-auto max-w-4xl px-6 text-center">
        <twig:ux:icon
            name="bi:headset"
            class="mx-auto size-10 text-primary-dark"
        />
        <h2 class="mt-5 text-3xl font-black sm:text-4xl">
            Besoin d'aide avec votre compte ?
        </h2>
        <p class="mx-auto mt-4 max-w-2xl leading-7 text-gray-600 dark:text-gray-400">
            Notre équipe reste disponible pour toute question sur vos
            commandes, vos adresses ou la sécurité de votre compte.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <twig:UI:Button variant="primary" tag="a" href="#">
                Contacter le support

                <twig:ux:icon
                    name="bi:arrow-right"
                    class="size-4"
                />
            </twig:UI:Button>
            <twig:UI:Button variant="ghost" tag="a" href="#">
                Retour à l'accueil
            </twig:UI:Button>
        </div>
    </div>
</section>